# ============ Server ============
# Port the API listens on (required). Do not commit .env with real values.
PORT=5000

# Optional: public base URL of this API (for logging only)
# BASE_URL=http://localhost:5000

# ============ CORS ============
# Frontend origin allowed by CORS (required for browser requests)
# Development (Vite default):
# FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://your-frontend-domain.com
FRONTEND_URL=

# Optional: comma-separated list of additional CORS origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ Database ============
# MongoDB connection string. Use env only; never hardcode.
MONGODB_URI=mongodb://localhost:27017/ieee-sb-miet

# ============ Auth ============
JWT_SECRET=your-jwt-secret-change-in-production

# ============ Cloudinary ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
