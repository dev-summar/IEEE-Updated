# ============ Server ============
PORT=5000
# Public base URL of this API (optional, for logging)
# BASE_URL=http://localhost:5000

# ============ CORS ============
# Frontend origin allowed by CORS (required for browser requests)
# Development (Vite default):
# FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://your-frontend-domain.com
FRONTEND_URL=

# Optional: comma-separated list of additional CORS origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ Database ============
MONGODB_URI=mongodb://localhost:27017/ieee-sb-miet

# ============ Auth ============
JWT_SECRET=your-jwt-secret-change-in-production

# ============ Cloudinary ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
