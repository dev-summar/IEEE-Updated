# ============ Frontend (Vite) ============
# Backend API base URL (required). Must include /api prefix.
# All frontend API calls use this via src/config/api.js — no hardcoded URLs.
#
# Development (backend on port 5000):
# VITE_API_BASE_URL=http://localhost:5000/api
#
# Production:
# VITE_API_BASE_URL=https://your-api-domain.com/api
#
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: alias read by api.js if VITE_API_BASE_URL is not set
# VITE_API_URL=http://localhost:5000/api
