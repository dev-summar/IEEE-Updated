# ============ Frontend (Vite) ============
# Backend API base URL - must include /api prefix. Required for API requests.
# Development (backend on port 5000): set one of the two below.
# VITE_API_BASE_URL=http://localhost:5000/api
# Production:
# VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: VITE_API_URL is also read if VITE_API_BASE_URL is not set.
